# Local DuckDB/CSV/HTTP execution needs no credentials.
# Copy to the repository's .env only for Tinker calls; never commit real secrets.
TINKER_API_KEY=
TINKER_COOKBOOK_RUNS_DIR=./runs

# Optional cloud extension only: `uv sync --locked --extra cloud`.
# Uncomment these fields when deliberately selecting cloud adapters.
# DATABRICKS_HOST=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_CATALOG=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=ELT_BENCH_RL
# SNOWFLAKE_ROLE=

# AIRBYTE_URL=http://localhost:8000
# AIRBYTE_CLIENT_ID=
# AIRBYTE_CLIENT_SECRET=
# AIRBYTE_WORKSPACE_ID=

# ELT_BENCH_RL_DOCKER_CONTEXT=colima-elt-bench-rl
